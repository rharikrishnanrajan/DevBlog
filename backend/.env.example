# Server Configuration
PORT=5000

# MySQL Database Configuration (e.g. Aiven / Cloud MySQL / Localhost)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=27008
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=blog
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Allowed Frontend Origin (specify exact production domain e.g. https://your-app.onrender.com or * for unrestricted)
FRONTEND_URL=*

