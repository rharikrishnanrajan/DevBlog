# ============================================================
# Dockerfile.versel — Vercel Container Image (Beta)
# https://vercel.com/docs/infrastructure/container-images
#
# Vercel detects this file at the project root, builds the
# image, stores it in the Vercel Container Registry (VCR),
# and deploys it as a Vercel Function.
#
# Requirements (per Vercel docs):
#   * HTTP server must listen on $PORT (default: 80)
#   * Gracefully handles SIGTERM (30-second window)
# ============================================================

# -- Stage 1: Build ------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root-level manifests first for layer caching
COPY package.json package-lock.json ./

# Install root dependencies (esbuild, etc.)
RUN npm ci --ignore-scripts

# Copy backend manifests and install all deps (incl. devDeps for tsc)
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --prefix backend

# Copy the rest of the backend source code
COPY backend/ ./backend/

# Compile TypeScript -> backend/dist/
RUN npm run build

# -- Stage 2: Production runner ------------------------------
FROM node:20-alpine AS runner

# Enable Express production optimisations
ENV NODE_ENV=production

WORKDIR /app

# Install only production dependencies
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

# Copy compiled output from the builder stage
COPY --from=builder /app/backend/dist ./dist

# Vercel injects $PORT at runtime; default to 80 per Vercel docs
ENV PORT=80
EXPOSE 80

# Node handles SIGTERM natively for Vercel 30-second graceful-shutdown window
CMD ["node", "dist/server.js"]
